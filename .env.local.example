# IroncladOps Environment Variables
# Copy this file to .env.local and fill in the values

# ─────────────────────────────────────────────
# REQUIRED: Google Apps Script Web App URL
# See README.md for full setup instructions
# ─────────────────────────────────────────────
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID_HERE/exec

# ─────────────────────────────────────────────
# OPTIONAL: Your production domain
# Used for sitemap, robots.txt, and OG metadata
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ironcladops.com